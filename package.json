{
  "name": "paperclip-desktop",
  "version": "3.2.13",
  "private": true,
  "description": "Paperclip desktop application \u2014 Electron wrapper for the Paperclip server",
  "author": {
    "name": "Aron Prins"
  },
  "homepage": "https://github.com/aronprins/paperclip-desktop",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc",
    "start": "electron dist/main.js",
    "prepare-server": "node scripts/prepare-server.mjs",
    "build-ui": "node scripts/build-ui.mjs",
    "prepare-release-assets:mac": "node scripts/prepare-macos-release-assets.mjs",
    "publish-release-assets:mac": "node scripts/publish-macos-release-assets.mjs",
    "smoke:mac:packaged": "node scripts/smoke-test-packaged-macos.mjs",
    "test:connections": "pnpm build && node --test test/connection-validate.test.mjs test/connection-preflight.test.mjs test/connection-profiles.test.mjs test/window-policy.test.mjs test/navigation-gestures.test.mjs test/local-server-lifecycle.test.mjs test/local-server-health.test.mjs",
    "test:prepare-release-assets:mac": "node --test test/prepare-macos-release-assets.test.mjs",
    "test:release-safety": "pnpm build && node --test test/runtime-safety.test.mjs test/prepare-macos-release-assets.test.mjs test/esbuild-normalization.test.mjs",
    "release:mac:local": "node scripts/release-macos-local.mjs",
    "release:mac:local:x64": "node scripts/release-macos-local.mjs --arch x64",
    "release:mac:local:arm64": "node scripts/release-macos-local.mjs --arch arm64",
    "release:mac:notarize:prebuilt": "node scripts/notarize-prebuilt-macos.mjs",
    "pack": "pnpm build && pnpm prepare-server && pnpm build-ui && electron-builder --dir",
    "dist": "pnpm build && pnpm prepare-server && pnpm build-ui && electron-builder",
    "dist:mac": "node scripts/release-macos-local.mjs",
    "dist:win": "pnpm build && pnpm prepare-server && pnpm build-ui && electron-builder --win --publish never",
    "dist:linux": "pnpm build && pnpm prepare-server && pnpm build-ui && electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.8.9",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@paperclipai/server": "2026.831.1",
    "@paperclipai/teams-catalog": "2026.824.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.7",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/sdk": "0.91.1",
      "@tootallnate/once": "2.0.1",
      "@xmldom/xmldom": "0.8.13",
      "@hono/node-server": "1.19.17",
      "better-auth": "1.6.25",
      "body-parser": "2.3.0",
      "brace-expansion@1.1.12": "1.1.18",
      "brace-expansion@1.1.13": "1.1.18",
      "brace-expansion@2.0.2": "2.1.4",
      "brace-expansion@2.0.3": "2.1.4",
      "brace-expansion@5.0.5": "5.0.9",
      "brace-expansion@5.0.6": "5.0.9",
      "defu": "6.1.7",
      "dompurify": "3.4.14",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.6",
      "fast-xml-parser": "5.7.3",
      "form-data": "4.0.6",
      "hono": "4.13.4",
      "ip-address": "10.5.0",
      "js-yaml": "4.3.1",
      "kysely": "0.28.17",
      "lodash": "4.18.1",
      "multer": "2.2.0",
      "path-to-regexp": "8.4.2",
      "qs": "6.15.2",
      "tar": "7.5.22",
      "tmp": "0.2.7",
      "undici@5.29.0": "6.28.0",
      "undici@6.25.0": "6.28.0",
      "undici@7.24.6": "7.29.0",
      "undici@7.28.0": "7.29.0",
      "ws": "8.21.1"
    },
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/win32-x64",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
